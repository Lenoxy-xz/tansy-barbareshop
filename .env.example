APP_NAME="Tansy Barbershop"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database lokal (XAMPP / MySQL) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dbtansy
DB_USERNAME=root
DB_PASSWORD=

# --- Produksi (Vercel + Neon/PostgreSQL): isi di dashboard Vercel, JANGAN di repository ---
# APP_ENV=production
# APP_DEBUG=false
# DB_CONNECTION=pgsql
# DB_URL=
# DB_SSLMODE=require
# SESSION_DRIVER=database
# CACHE_DRIVER=database
# CACHE_STORE=database
# SESSION_SECURE_COOKIE=true
# LOG_CHANNEL=stderr

# --- Seeder (dijalankan dari komputer lokal, hanya saat database masih kosong). Wajib: min. 8 karakter, huruf besar, huruf kecil, angka ---
# SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_PASSWORD=
# SEED_USER_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
