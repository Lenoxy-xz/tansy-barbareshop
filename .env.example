APP_NAME="Tansy Barbershop"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database lokal (XAMPP / MySQL) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dbtansy
DB_USERNAME=root
DB_PASSWORD=

# --- Database produksi (Neon / PostgreSQL): isi di dashboard hosting, JANGAN di repository ---
# DB_CONNECTION=pgsql
# DB_URL=
# DB_SSLMODE=require

# --- Seeder (dipakai hanya saat database masih kosong). Wajib: min. 8 karakter, huruf besar, huruf kecil, angka ---
# SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_PASSWORD=
# SEED_USER_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
